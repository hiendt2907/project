# omni-gateway:latest — Ingress only: COPY chỉ src/gateway + requirements-gateway.txt (không workers/LLM/executor).
FROM python:3.13-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 10001 --shell /bin/bash appuser

WORKDIR /app

COPY requirements-gateway.txt .
RUN pip install --no-cache-dir -r requirements-gateway.txt

COPY src/gateway/ /app/src/gateway/
# Admin config store (Postgres omni_admin) — shared service, KHÔNG phải workers.
# repo/pool/cache nhẹ (asyncpg lazy, không kéo chain_writer/cryptography).
COPY src/services/__init__.py /app/src/services/__init__.py
COPY src/services/admin_config/ /app/src/services/admin_config/
# IT-6: PG durability ledger cho durable command channel (agent_runtime.py)
COPY src/services/agent_command_ledger/ /app/src/services/agent_command_ledger/
# Sổ ca: gateway phục vụ /competency/* và ghi verdict HITL. Đặt ở services/ chính vì
# CẢ gateway lẫn workers đều cần, mà gateway KHÔNG được import workers/.
COPY src/services/case_ledger/ /app/src/services/case_ledger/
COPY migrations/ /app/migrations/
COPY src/pkg/__init__.py /app/src/pkg/__init__.py
COPY src/pkg/risk_taxonomy.py /app/src/pkg/risk_taxonomy.py
COPY src/pkg/autonomy/ /app/src/pkg/autonomy/
COPY src/pkg/reasoning/ /app/src/pkg/reasoning/
COPY src/pkg/rag/ /app/src/pkg/rag/
COPY src/pkg/observability/ /app/src/pkg/observability/
COPY src/pkg/onboarding/ /app/src/pkg/onboarding/
# Catalogue lệnh chẩn đoán — gateway fail-fast trước khi enqueue command cho agent.
# ⚠️ Dockerfile này COPY TỪNG THƯ MỤC CON của src/pkg/, không COPY cả cây. Thêm một
# package mới dưới src/pkg/ mà quên thêm dòng ở đây thì `make deploy-gateway` vẫn báo
# "rollout successful" và pod vẫn Running — chỉ thiếu module, và catalogue load lỗi
# nghĩa là MỌI command bị từ chối (fail-closed). Đã trả giá một lần: verify bằng
# `kubectl exec … python -c "import pkg.diagnostics.validator"`, không bằng rollout.
COPY src/pkg/diagnostics/ /app/src/pkg/diagnostics/
COPY src/pkg/domain/ /app/src/pkg/domain/
COPY config/diagnostic_commands.yaml /app/config/diagnostic_commands.yaml
# AOIP domain model (Observation/Fact/SystemModel/CompetencyMatrix/Claims/Questions) —
# pure domain package, không import workers/executor/LLM. Cần cho routes/onboarding.py
# (/onboarding/competency, /unknowns, /questions*) từ slice O2A/O2B.
COPY src/aoip/ /app/src/aoip/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

USER appuser

EXPOSE 8000

CMD ["uvicorn", "gateway.api:app", "--host", "0.0.0.0", "--port", "8000"]
