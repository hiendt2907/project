# Omni environment variables — copy to .env and fill real values.
# OrbStack DNS: host.orb.internal routes K8s pod traffic to the macOS host.

# Telegram notifications
TELEGRAM_BOT_TOKEN="<your-bot-token>"
TELEGRAM_CHAT_ID="<your-chat-id>"

# LLM — Ollama on macOS host (OpenAI-compatible /v1)
LLM_BASE_URL="http://host.orb.internal:11434/v1"
LLM_MODEL_NAME="qwen2.5-coder:7b"

# Embeddings — same Ollama instance
EMBED_BASE_URL="http://host.orb.internal:11434/v1"
EMBED_MODEL_NAME="nomic-embed-text"

# ─── Cloudflare public surface (app.omnisre.xyz) ──────────────────────────────
# Chỉ là giá trị THAM CHIẾU cho người vận hành. Runtime KHÔNG đọc file này: các
# biến public thật được khai báo trong k8s/deployments/aoip-provider-portal-public.yaml.
# Không đặt secret ở đây.

PUBLIC_APP_URL="https://app.omnisre.xyz"
PUBLIC_WWW_URL="https://www.omnisre.xyz"
PUBLIC_OIDC_ISSUER="https://app.omnisre.xyz/dex"

# Placeholder cho bước thủ công trên Cloudflare Dashboard (xem runbook).
CLOUDFLARE_TUNNEL_ID="<tunnel-id>"
CLOUDFLARE_ACCESS_TEAM_DOMAIN="<team>.cloudflareaccess.com"
CLOUDFLARE_ACCESS_ADMIN_EMAIL="danghien2907@gmail.com"

# Secret KHÔNG bao giờ nằm ở đây — chúng sống trong Kubernetes Secret:
#   aoip-dex-public-config             (config.yaml của Dex public)
#   aoip-provider-portal-public-secret (AOIP_OIDC_PROVIDER_CLIENT_SECRET)
# và trong ~/.cloudflared/<tunnel-id>.json (credentials tunnel, chmod 600).

# CHƯA public ở iteration này — cố ý để trống, mở là một phase riêng:
# PUBLIC_API_URL=
# PUBLIC_AGENT_URL=
