{
  "title": "L1 AI Reasoning",
  "uid": "l1-ai-reasoning",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": "label_values(up, kubernetes_namespace)",
        "current": { "selected": true, "text": "multi-agent", "value": "multi-agent" }
      },
      {
        "name": "trace_id",
        "label": "trace_id",
        "type": "textbox",
        "query": "",
        "current": { "selected": true, "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Cach doc nhanh",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Muc tieu:** biet AI dang suy luan tot hay khong. Theo thu tu: ReAct volume -> latency -> hit-rate RAG -> Wilson confidence. Neu can truy vet, click vao trace_id/namespace de nhay L3."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "ReAct Loop: sessions / llm_calls / exhausted",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(omni_agent_sessions_total[5m]))", "legendFormat": "sessions/s" },
        { "refId": "B", "expr": "sum(rate(omni_llm_requests_total[5m]))", "legendFormat": "llm_calls/s" },
        { "refId": "C", "expr": "sum(rate(omni_slow_path_exhausted_total[5m]))", "legendFormat": "slow_path_exhausted/s" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ollama latency p95 (proxy qua worker_latency)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(omni_worker_latency_seconds_bucket[5m])))",
          "legendFormat": "p95_latency_s"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "RAG Vector Hit-rate (5m)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(omni_fastpath_hits_total[5m])) / clamp_min(sum(rate(omni_fastpath_hits_total[5m])) + sum(rate(omni_llm_requests_total[5m])), 1e-9))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Wilson Confidence Score (lower bound)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "max(omni_wilson_confidence_score)" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 3 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Bang trace reasoning (click de drill-down L3)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"$namespace\", pod_name=~\"omni-worker.*\"} | json | trace_id != \"\" | line_format \"{{.trace_id}} {{.namespace}} {{.event}}\""
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open L3 for trace",
                    "url": "/d/l3-dataflow-traces/l3-dataflow-traces?orgId=1&var-trace_id=${__value.text}&var-namespace=${namespace}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "namespace" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open L3 for namespace",
                    "url": "/d/l3-dataflow-traces/l3-dataflow-traces?orgId=1&var-namespace=${__value.text}&var-trace_id=${trace_id}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}
