{
  "title": "Omni Learning",
  "uid": "omni-learning",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["omni", "learning"],
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": "label_values(up, kubernetes_namespace)",
        "current": { "selected": true, "text": "multi-agent", "value": "multi-agent" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Learning upserts trend",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(omni_learning_upserts_total[5m]))", "legendFormat": "upserts/s" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Verified success vs failure",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(omni_proactive_verify_total{outcome=\"success\"}[5m]))", "legendFormat": "verified_success/s" },
        { "refId": "B", "expr": "sum(rate(omni_proactive_verify_total{outcome=\"failed\"}[5m]))", "legendFormat": "verified_failed/s" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Planner fallback events (1h)",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum(count_over_time({namespace=\"$namespace\",pod_name=~\"omni-analyst.*|omni-core.*\"} |= \"PLANNER_FALLBACK\" [1h]))" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Proof gate blocked (1h)",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum(count_over_time({namespace=\"$namespace\",pod_name=~\"omni-.*\"} |= \"ERR_REA_SIGMA_GATE_BLOCKED\" [1h]))" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "No-physical-proof blocked (1h)",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "sum(count_over_time({namespace=\"$namespace\",pod_name=~\"omni-.*\"} |= \"ERR_REA_NO_PHYSICAL_PROOF\" [1h]))" }]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Learning evidence snapshots",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{namespace=\"$namespace\", pod_name=~\"omni-.*\"} |~ \"learning_upsert|action_experience|VERIFIED_SUCCESS|PLAN_EMITTED\"" }]
    }
  ]
}
