{
  "title": "L2 Infra 3-Sigma",
  "uid": "l2-infra-3sigma",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": "label_values(up, kubernetes_namespace)",
        "current": { "selected": true, "text": "multi-agent", "value": "multi-agent" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Cach doc 3-sigma",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Cong thuc bat buoc: **Z = (value - avg) / stddev**. Bat thuong khi **abs(Z) > 3**. Nhin 4 do thi Z ben duoi, sau do xem bang anomaly de biet metric nao vuot nguong."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Z-Score",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "omni:node_cpu:z", "legendFormat": "cpu_z" },
        {
          "refId": "B",
          "expr": "((omni:cpu_busy:instant - omni:node_cpu:avg_24h) / clamp_min(omni:node_cpu:stddev_24h, 1e-9))",
          "legendFormat": "cpu_formula_z"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 3 }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAM Z-Score",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "omni:mem:z", "legendFormat": "mem_z" },
        {
          "refId": "B",
          "expr": "((omni:mem_avail_ratio:instant - omni:node_mem:avg_24h) / clamp_min(omni:node_mem:stddev_24h, 1e-9))",
          "legendFormat": "mem_formula_z"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk IOPS Z-Score",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "omni:node_iops:z", "legendFormat": "iops_z" },
        {
          "refId": "B",
          "expr": "((omni:iops_total:instant - omni:node_iops:avg_24h) / clamp_min(omni:node_iops:stddev_24h, 1e-9))",
          "legendFormat": "iops_formula_z"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk usage Z-Score",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "omni:node_disk:z", "legendFormat": "disk_z" },
        {
          "refId": "B",
          "expr": "((omni:disk_used_ratio:instant - omni:node_disk:avg_24h) / clamp_min(omni:node_disk:stddev_24h, 1e-9))",
          "legendFormat": "disk_formula_z"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "3-sigma anomalies (abs(Z) > 3)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "refId": "A", "expr": "abs(((omni:cpu_busy:instant - omni:node_cpu:avg_24h) / clamp_min(omni:node_cpu:stddev_24h, 1e-9))) > 3", "format": "table", "instant": true },
        { "refId": "B", "expr": "abs(((omni:mem_avail_ratio:instant - omni:node_mem:avg_24h) / clamp_min(omni:node_mem:stddev_24h, 1e-9))) > 3", "format": "table", "instant": true },
        { "refId": "C", "expr": "abs(((omni:disk_used_ratio:instant - omni:node_disk:avg_24h) / clamp_min(omni:node_disk:stddev_24h, 1e-9))) > 3", "format": "table", "instant": true },
        { "refId": "D", "expr": "abs(((omni:iops_total:instant - omni:node_iops:avg_24h) / clamp_min(omni:node_iops:stddev_24h, 1e-9))) > 3", "format": "table", "instant": true }
      ],
      "options": { "showHeader": true }
    }
  ]
}
