{
  "title": "Omni Pod Resources",
  "uid": "omni-pod-resources",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "tags": ["omni", "resources", "pods", "redis", "kafka"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "mimir" },
        "query": "label_values(kube_pod_info{namespace!=\"kube-system\"}, namespace)",
        "current": { "selected": true, "text": "multi-agent", "value": "multi-agent" },
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running pods",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Running\"}==1)" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CrashLoopBackOff pods",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "sum(kube_pod_container_status_waiting_reason{namespace=~\"$namespace\",reason=\"CrashLoopBackOff\"})" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Redis up",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "max(redis_up)" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Consumer stuck heuristic (15m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "sum((max_over_time(omni_worker_lag_size[15m]) > bool 0) * (changes(omni_worker_lag_size[15m]) == bool 0))" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod CPU usage cores (top 20)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by(namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-nodes-resource\",namespace!=\"kube-system\",namespace=~\"$namespace\",pod!=\"\",container!=\"\",container!=\"POD\"}[5m])))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pod memory working set MiB (top 20)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by(namespace, pod) (container_memory_working_set_bytes{job=\"kubernetes-nodes-resource\",namespace!=\"kube-system\",namespace=~\"$namespace\",pod!=\"\",container!=\"\",container!=\"POD\"}) / 1024 / 1024)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "MiB" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pod CPU utilization vs request (%) top 15",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, 100 * (sum by(namespace,pod) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-nodes-resource\",namespace!=\"kube-system\",namespace=~\"$namespace\",pod!=\"\",container!=\"\",container!=\"POD\"}[5m])) / clamp_min(sum by(namespace,pod) (kube_pod_container_resource_requests{namespace!=\"kube-system\",namespace=~\"$namespace\",resource=\"cpu\",unit=\"core\"}), 0.001)))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pod memory utilization vs request (%) top 15",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, 100 * (sum by(namespace,pod) (container_memory_working_set_bytes{job=\"kubernetes-nodes-resource\",namespace!=\"kube-system\",namespace=~\"$namespace\",pod!=\"\",container!=\"\",container!=\"POD\"}) / clamp_min(sum by(namespace,pod) (kube_pod_container_resource_requests{namespace!=\"kube-system\",namespace=~\"$namespace\",resource=\"memory\",unit=\"byte\"}), 1)))",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Pod restart increase (30m) top 20",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by(namespace,pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[30m])))",
          "format": "table",
          "instant": true
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kafka consumer lag proxy (omni_worker_lag_size by app)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(app) (omni_worker_lag_size)",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Redis blocked clients",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "redis_blocked_clients", "legendFormat": "{{kubernetes_pod_name}}" }]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Redis commands processed /s",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "{{kubernetes_pod_name}}" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Redis memory used MiB",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "redis_memory_used_bytes / 1024 / 1024", "legendFormat": "{{kubernetes_pod_name}}" }],
      "fieldConfig": { "defaults": { "unit": "MiB" }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Redis stream backlog (30m max) by stream",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [{ "refId": "A", "expr": "sum by(stream) (max_over_time(omni_redis_stream_backlog[30m]))", "legendFormat": "{{stream}}" }]
    },
    {
      "id": 15,
      "type": "logs",
      "title": "DLQ events logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"multi-agent\", pod_name=~\"omni-.*\"} |~ \"dlq|omni-dlq|events:dlq\""
        }
      ]
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Kafka pipeline logs (topics/consumer hints)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"multi-agent\", pod_name=~\"omni-.*|kafka-.*\"} |~ \"kafka|omni-alerts|omni-actions|omni-action-feedback|consumer\""
        }
      ]
    }
  ]
}
