# Canonical AOIP recovery-gate config — source of truth for the
# AOIP_GATE_*/AOIP_ALLOWED_SYSTEMD_UNITS block inside each VM's
# /opt/omni-remote-agent/run.env (see src/aoip/agent/runtime_config.py::_build_gate
# for the full list of variables read from this block).
#
# Deployed to all 3 lab VMs (cust-app/cust-edge/cust-db) via
# scripts/deploy_aoip_gate_config.sh. Editing this file and re-running the
# script is now the ONLY supported way to change gate config — no more
# hand-SSH + sed on individual VMs (that caused undetectable 3-VM drift,
# see task context 2026-07-21).
#
# Format: plain KEY=VALUE, one per line, no quoting — matches the format
# run.env already uses (see scripts/lib/remote_agent_provisioning.py::render_run_env).
#
# disk_pressure_journal added here for capability #3 (journal-vacuum, being
# built in parallel by another agent). This file intentionally lists it
# BEFORE src/aoip/recovery.py::OPERATORS registers an operator for it — see
# tests/test_aoip_gate_config.py::test_catalog_consistency, which is
# EXPECTED to fail until that registration lands. Do not deploy this file to
# real VMs (or flip AOIP_AGENT_MODE=mutation_enabled) until that test is green.
AOIP_GATE_ALLOWED_FAILURE_MODES=process_down,failed_state_stale,disk_pressure_journal
AOIP_GATE_ALLOWED_SUBSTRATES=systemd
AOIP_GATE_SCOPE_PREFIX=svc:
AOIP_GATE_MAX_RISK=0.5
AOIP_GATE_MIN_DIAGNOSIS_CONFIDENCE=0.5
AOIP_GATE_MAX_DIAGNOSIS_AGE_S=300
AOIP_ALLOWED_SYSTEMD_UNITS=payment-api.service
