# Secrets and credentials
.env
.env.*
*.pem
*.key
*.crt
secrets/
k8s/secrets/

# Python env and caches
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
.benchmarks/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Logs and runtime dumps
*.log
logs/
agent_logs/
metrics_dump/
*.out
*.err
*.trace
*.trace.json
*.trace.ndjson
*.prof
*.cpuprofile

# Local state and databases
qdrant_storage/
redis_data/
*.db
*.sqlite
*.sqlite3
*.rdb
*.aof

# Frontend artifacts (if present)
node_modules/
.next/
.nuxt/
coverage/

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.windsurf/
.system/
.cursor/debug-*.log
.cursor/sessions/
.cursor/history/
.cursor/cache/

# Bulky media/docs usually not needed for coding context
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mov
*.pdf
*.svg
*.webp

# Extra heavy binary/archive types
*.zip
*.tar
*.gz
*.tgz
*.bz2
*.xz

# VCS metadata
.git/
.svn/

# Generated docs/artifacts and exports
docs/**/site/
docs/**/_build/
docs/**/*.drawio
docs/**/*.pptx
docs/**/*.key
docs/**/*.csv
docs/**/*.tsv

# Kubernetes / observability heavy exports
k8s/monitor/dashboards/*.json
k8s/**/rendered/
*.promdump
*.pcap

# Legacy deployments (canonical: k8s/deployments/)
deployments/

# Heavy mirrored vendor docs (keep markdown/json index files)
docs/vendor/**/*.html
docs/vendor/**/*.htm

# Temp folders
tmp/
temp/
.tmp/

# Keep high-signal governance + runbook knowledge in context
!docs/runbooks/**/*.md
!docs/reports/project-memory.md
!docs/vendor/knownbase.md
!docs/DOCUMENTATION_INDEX.md
!docs/vendor/OMNI_PROJECT_CANONICAL.md